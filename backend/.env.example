# SupplySense AI - Environment Configuration
APP_NAME=SupplySense AI
ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL by default; falls back to SQLite if empty/inaccessible)
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplysense_db
DATABASE_URL=sqlite:///./supplysense.db

# ML Settings
DEFAULT_FORECAST_HORIZON_DAYS=14
ML_MODEL_TYPE=random_forest  # Options: xgboost, random_forest, gradient_boosting
ANOMALY_CONTAMINATION=0.05

